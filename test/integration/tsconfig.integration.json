{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "../../out-integration",
    "rootDir": "../..",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha", "vscode"]
  },
  "include": ["../../src/**/*.ts", "../../test/integration/**/*.ts", "../../test/fixtures/**/*.ts"],
  "exclude": ["../../node_modules", "../../src/webview", "../../dist"]
}
