{
  "name": "image-compare",
  "displayName": "ImageCompare",
  "description": "Compare multiple images (tuples) with multiple modalities",
  "version": "0.4.1",
  "publisher": "obukhovai",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/toshas/ImageCompare_vscode"
  },
  "homepage": "https://github.com/toshas/ImageCompare_vscode#readme",
  "bugs": {
    "url": "https://github.com/toshas/ImageCompare_vscode/issues"
  },
  "keywords": [
    "image",
    "compare",
    "viewer",
    "visualization",
    "overlay"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "imageCompare.openInCompare",
        "title": "Open in ImageCompare"
      },
      {
        "command": "imageCompare.copyImage",
        "title": "Copy Image"
      },
      {
        "command": "imageCompare.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "imageCompare.revealInExplorer",
        "title": "Reveal in Explorer"
      },
      {
        "command": "imageCompare.hideModality",
        "title": "Hide Modality"
      },
      {
        "command": "imageCompare.showModality",
        "title": "Show Modality"
      },
      {
        "command": "imageCompare.saveSessionAs",
        "title": "Save Session As…",
        "icon": "$(save-as)"
      }
    ],
    "customEditors": [
      {
        "viewType": "imageCompare.sessionFile",
        "displayName": "ImageCompare",
        "selector": [
          {
            "filenamePattern": "*.imagecompare"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "imageCompare.saveSessionAs",
          "when": "activeCustomEditorId == 'imageCompare.sessionFile'",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "imageCompare.openInCompare",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        },
        {
          "command": "imageCompare.openInCompare",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(png|jpg|jpeg|gif|bmp|webp|tiff|tif|ppmx)$/i",
          "group": "navigation@10"
        }
      ],
      "webview/context": [
        {
          "command": "imageCompare.copyImage",
          "when": "webviewSection == 'imageCompareImage'",
          "group": "1_imagecompare@1"
        },
        {
          "command": "imageCompare.copyPath",
          "when": "webviewSection == 'imageCompareImage' || webviewSection == 'imageComparePill'",
          "group": "1_imagecompare@2"
        },
        {
          "command": "imageCompare.revealInExplorer",
          "when": "webviewSection == 'imageCompareImage' || webviewSection == 'imageComparePill'",
          "group": "1_imagecompare@3"
        },
        {
          "command": "imageCompare.hideModality",
          "when": "webviewSection == 'imageComparePill' && !imageCompareHidden",
          "group": "2_imagecompare@1"
        },
        {
          "command": "imageCompare.showModality",
          "when": "webviewSection == 'imageComparePill' && imageCompareHidden",
          "group": "2_imagecompare@1"
        }
      ],
      "commandPalette": [
        {
          "command": "imageCompare.copyImage",
          "when": "false"
        },
        {
          "command": "imageCompare.copyPath",
          "when": "false"
        },
        {
          "command": "imageCompare.revealInExplorer",
          "when": "false"
        },
        {
          "command": "imageCompare.hideModality",
          "when": "false"
        },
        {
          "command": "imageCompare.showModality",
          "when": "false"
        },
        {
          "command": "imageCompare.saveSessionAs",
          "when": "activeCustomEditorId == 'imageCompare.sessionFile'"
        }
      ]
    },
    "configuration": {
      "title": "ImageCompare",
      "properties": {
        "imageCompare.thumbnailSize": {
          "type": "number",
          "default": 100,
          "minimum": 50,
          "maximum": 200,
          "description": "Resolution carousel thumbnails are decoded and cached at, in pixels (longest side, 2x this value). Not the on-screen size: that is derived from the carousel width divided by the number of modalities."
        },
        "imageCompare.prefetchCount": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of tuples to prefetch ahead and behind current position"
        },
        "imageCompare.maxConcurrentReads": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "description": "How many image reads/decodes may run at once. 0 (auto) sizes the pool from os.availableParallelism() and caps it at the extension host's libuv thread pool (4) plus 2: Sharp holds one libuv thread per decode, so a wider pool buys no throughput and only queues work ahead of the image you are looking at. Raise it only if you gave VS Code a larger UV_THREADPOOL_SIZE, or on a fast unconstrained machine. Takes effect on the next window reload. See docs/loading-architecture.md."
        },
        "imageCompare.prefetchTransportBudgetMB": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 512,
          "description": "Remote sessions only: how many megabytes of speculatively prefetched images may be in flight to the viewer at once. Prefetch shares one serialized channel with the thumbnails and with the image you are looking at, so an unbounded wave delays both. 0 disables the bound; it is always disabled locally, where there is no channel to share. See docs/loading-architecture.md."
        },
        "imageCompare.keepZoomOnTupleChange": {
          "type": "boolean",
          "default": false,
          "description": "Keep the current zoom and pan when switching to another image tuple. When disabled, changing tuples resets the view. Zoom always persists across modality switches within a tuple."
        },
        "imageCompare.cacheMaxAgeDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "description": "How long unused thumbnail cache entries are kept, in days. Age is counted from last use for the packfile the cache is served from, so an actively used cache never expires under you; per-entry files are counted from when they were written. See docs/image-backends.md."
        },
        "imageCompare.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging to the 'ImageCompare' output channel (View > Output > ImageCompare): tuple matching, the open-time thumbnail sweep, work-pool load, outbound bytes and prefetch waves. See docs/testing.md."
        },
        "imageCompare.debugVerbose": {
          "type": "boolean",
          "default": false,
          "description": "With imageCompare.debug on, also log one line per thumbnail and per outbound message. Thousands of lines on a large session — enable only while diagnosing."
        },
        "imageCompare.debugConsole": {
          "type": "boolean",
          "default": false,
          "description": "With imageCompare.debug on, also mirror every debug line to the developer console. Off by default: VS Code replays extension-host console output into the renderer, which is itself a measurable cost on remote sessions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "build:standalone": "node scripts/build-standalone.mjs",
    "alpha": "node scripts/local-alpha.mjs",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "test": "vitest run --config test/vitest.config.ts",
    "test:unit": "vitest run --config test/vitest.config.ts",
    "test:unit:watch": "vitest --config test/vitest.config.ts",
    "test:webview": "playwright test --config test/webview/playwright.config.ts",
    "test:integration": "tsc -p test/integration/tsconfig.integration.json && vscode-test",
    "test:all": "npm run test:unit && npm run compile && npm run test:webview && npm run test:integration",
    "test:dashboard": "node test/dashboard/generate.mjs",
    "test:dashboard:reuse": "node test/dashboard/generate.mjs --reuse",
    "test:demos": "playwright test --config=test/demos/playwright.demos.config.ts && node test/demos/build-gallery.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "check:refs": "node scripts/check-no-personal-refs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.54.0",
    "js-yaml": "^4.3.2",
    "mocha": "^10.8.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "vitest": "^2.1.8",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "jimp": "^1.6.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.34.5"
  },
  "optionalDependencies": {
    "@img/sharp-wasm32": "^0.34.5"
  }
}
