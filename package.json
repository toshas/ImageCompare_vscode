{
  "name": "image-compare",
  "displayName": "ImageCompare",
  "description": "Compare multiple images (tuples) with multiple modalities",
  "version": "0.3.0",
  "publisher": "obukhovai",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/toshas/ImageCompare_vscode"
  },
  "homepage": "https://github.com/toshas/ImageCompare_vscode#readme",
  "bugs": {
    "url": "https://github.com/toshas/ImageCompare_vscode/issues"
  },
  "keywords": [
    "image",
    "compare",
    "viewer",
    "visualization",
    "overlay"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "imageCompare.openInCompare",
        "title": "Open in ImageCompare"
      },
      {
        "command": "imageCompare.copyImage",
        "title": "Copy Image"
      },
      {
        "command": "imageCompare.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "imageCompare.revealInExplorer",
        "title": "Reveal in Explorer"
      },
      {
        "command": "imageCompare.hideModality",
        "title": "Hide Modality"
      },
      {
        "command": "imageCompare.showModality",
        "title": "Show Modality"
      },
      {
        "command": "imageCompare.saveSessionAs",
        "title": "Save Session As…",
        "icon": "$(save-as)"
      }
    ],
    "customEditors": [
      {
        "viewType": "imageCompare.sessionFile",
        "displayName": "ImageCompare",
        "selector": [
          {
            "filenamePattern": "*.imagecompare"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "imageCompare.saveSessionAs",
          "when": "activeCustomEditorId == 'imageCompare.sessionFile'",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "imageCompare.openInCompare",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        },
        {
          "command": "imageCompare.openInCompare",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(png|jpg|jpeg|gif|bmp|webp|tiff|tif|ppmx)$/i",
          "group": "navigation@10"
        }
      ],
      "webview/context": [
        {
          "command": "imageCompare.copyImage",
          "when": "webviewSection == 'imageCompareImage'",
          "group": "1_imagecompare@1"
        },
        {
          "command": "imageCompare.copyPath",
          "when": "webviewSection == 'imageCompareImage' || webviewSection == 'imageComparePill'",
          "group": "1_imagecompare@2"
        },
        {
          "command": "imageCompare.revealInExplorer",
          "when": "webviewSection == 'imageCompareImage' || webviewSection == 'imageComparePill'",
          "group": "1_imagecompare@3"
        },
        {
          "command": "imageCompare.hideModality",
          "when": "webviewSection == 'imageComparePill' && !imageCompareHidden",
          "group": "2_imagecompare@1"
        },
        {
          "command": "imageCompare.showModality",
          "when": "webviewSection == 'imageComparePill' && imageCompareHidden",
          "group": "2_imagecompare@1"
        }
      ],
      "commandPalette": [
        {
          "command": "imageCompare.copyImage",
          "when": "false"
        },
        {
          "command": "imageCompare.copyPath",
          "when": "false"
        },
        {
          "command": "imageCompare.revealInExplorer",
          "when": "false"
        },
        {
          "command": "imageCompare.hideModality",
          "when": "false"
        },
        {
          "command": "imageCompare.showModality",
          "when": "false"
        },
        {
          "command": "imageCompare.saveSessionAs",
          "when": "activeCustomEditorId == 'imageCompare.sessionFile'"
        }
      ]
    },
    "configuration": {
      "title": "ImageCompare",
      "properties": {
        "imageCompare.thumbnailSize": {
          "type": "number",
          "default": 100,
          "minimum": 50,
          "maximum": 200,
          "description": "Resolution carousel thumbnails are decoded and cached at, in pixels (longest side, 2x this value). Not the on-screen size: that is derived from the carousel width divided by the number of modalities."
        },
        "imageCompare.prefetchCount": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of tuples to prefetch ahead and behind current position"
        },
        "imageCompare.keepZoomOnTupleChange": {
          "type": "boolean",
          "default": false,
          "description": "Keep the current zoom and pan when switching to another image tuple. When disabled, changing tuples resets the view. Zoom always persists across modality switches within a tuple."
        },
        "imageCompare.cacheMaxAgeDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "description": "Maximum age of cached thumbnails in days"
        },
        "imageCompare.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging. Watcher and sweep events ([IC-EXT]) go to the webview developer console (Help > Toggle Developer Tools); tuple-matching traces ([IC-MATCH]) go to the Extension Host output."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "test": "ts-node src/test/tupleMatching.test.ts && ts-node src/test/pngTextChunk.test.ts && ts-node src/test/sessionFile.test.ts && ts-node src/test/watcherLogic.test.ts && ts-node src/test/workPool.test.ts && ts-node src/test/ppmxParser.test.ts && ts-node src/test/modalityVisibility.test.ts && ts-node src/test/thumbPack.test.ts && ts-node src/test/wireFormat.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "jimp": "^1.6.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.34.5"
  },
  "optionalDependencies": {
    "@img/sharp-wasm32": "^0.34.5"
  }
}
