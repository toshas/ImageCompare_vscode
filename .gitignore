.DS_Store
node_modules/
dist/
out/
*.vsix
.vscode-test/

# Test data (large image files)
test_images/

# Agent config: ignore local state, keep the shared symlinks into /skills and /agents
/.claude/*
!/.claude/skills/
!/.claude/agents/
/.agents/*
!/.agents/skills/

# Scratch for an audit round: ledgers and the pre-images a fix-verifier diffs against
.agent-runs/

# Test artifacts
out-integration/
.dashboard-data/
test-results/
playwright-report/
test/webview/harness/

# stray tsc declaration output under test/ (configs + specs)
test/**/*.d.ts
test/**/*.d.ts.map

# Generated test outputs — never versioned: rebuild on demand (test:demos / test:dashboard) or download the CI demo-gallery artifact
test/demos/raw/
test/demos/gallery/
test/dashboard/dashboard.html
test/dashboard/FEATURES.md

# Playwright JSON written with a stale cwd — generated, and it embeds absolute paths
test/webview/test/
test/dashboard/results/

# Local list of terms the pre-commit guard blocks — personal, never versioned
.words-to-check.txt
