# Source and build files
.claude/**
.vscode/**
.vscode-test/**
src/**
out/**
demo.gif
# Un-ignores below are what ship Sharp; dropping any, incl. transitive deps, fails in the VSIX only (docs/image-backends.md: vsix-modules-hand-assembled).
# sharp@0.34 needs @img/colour (covered by @img/**), detect-libc, semver; @emnapi is the wasm32 target's runtime.
node_modules/**
!node_modules/sharp/**
!node_modules/@img/**
!node_modules/@emnapi/**
!node_modules/detect-libc/**
!node_modules/semver/**

# Config files
.gitignore
tsconfig*.json
webpack.config.js
package-lock.json

# Source maps
*.map
**/*.map

# Development docs and tooling (must not ship to users in the VSIX).
# skills/imagecompare/ is deliberately NOT excluded: it ships so a user's agent can drive the extension.
skills/README.md
skills/verify-docs/**
CLAUDE.md
CONTRIBUTING.md
docs/**
dev_backlog/**
scripts/**
.github/**

# Testing bed and dev tooling (not shipped)
test/**
.dashboard-data/**
# Gitignored working files: .vscodeignore is a SEPARATE list and vsce packs the working tree,
# not git, so anything only .gitignore covers still ships unless it is named here too.
.agent-runs/**
test-results/**
**/test-results/**
out-integration/**
.words-to-check.txt
NIGHT-RUN-NOTES.md
ITERATION-TIPS.md
.dashboard-data/**
.vscode-test.mjs

# Test data
test_images/**

# Git
.git/**
